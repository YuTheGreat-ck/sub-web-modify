# ==========================================
# RRYS 订阅转换前端 - 生产环境配置
# ==========================================

# [项目信息]
VUE_APP_PROJECT = "https://github.com/YuTheGreat-ck/sub-web-modify"

# [社交链接] - 已根据你的要求清空，保持界面整洁
VUE_APP_BOT_LINK = ""
VUE_APP_BILIBILI_LINK = ""
VUE_APP_YOUTUBE_LINK = ""

# [视频教程] - 已清空
VUE_APP_BASIC_VIDEO = ""
VUE_APP_ADVANCED_VIDEO = ""

# --- 核心后端配置 (关键) ---

# 1. 订阅转换后端 API (负责逻辑转换)
VUE_APP_SUBCONVERTER_DEFAULT_BACKEND = "https://api.rrys.eu.cc"

# 2. 默认远程配置 (你的短链地址)
# 作用：打开页面时，“远程配置”栏会自动填入此项，作为默认的分组/测速规则
VUE_APP_SUBCONVERTER_REMOTE_CONFIG = "https://d.rrys.eu.cc/y"

# 3. 短链接后端
# 如果你自己的 d.rrys.eu.cc 支持 MyUrls 接口规范，可以填它；
# 否则建议保持使用 v1.mk 以确保点击“生成短链接”时成功率最高。
VUE_APP_MYURLS_DEFAULT_BACKEND = "https://v1.mk"

# 4. 文本托管后端
# 用于用户上传自定义配置，建议使用成熟的公共接口
VUE_APP_CONFIG_UPLOAD_BACKEND = "https://subapi.v1.mk"

# --- 规则文档参考 (保持默认) ---
VUE_APP_SCRIPT_CONFIG = "https://github.com/tindy2013/subconverter/blob/a24cb7c00a7e5a71ef2e6c0d64d84d91bc7a21d6/README-cn.md?plain=1#L703-L719"
VUE_APP_FILTER_CONFIG = "https://github.com/tindy2013/subconverter/blob/a24cb7c00a7e5a71ef2e6c0d64d84d91bc7a21d6/README-cn.md?plain=1#L514-L531"

# --- 进阶功能控制 ---
VUE_APP_SHOW_ADVANCED_BATCH = true
VUE_APP_USE_CUSTOM_BACKEND = 1
